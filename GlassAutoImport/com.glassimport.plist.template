<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.glassimport</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/bin/glass-import.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/glass-import.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/glass-import.stderr.log</string>
</dict>
</plist>
